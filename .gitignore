# =============================================================================
# Career Intelligence — .gitignore
# =============================================================================

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Secrets & credentials (NEVER commit) ------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*credentials*.json
*secret*.json
*token*.json
.databrickscfg
.streamlit/secrets.toml

# Local configuration (templates ending in .example.* ARE committed)
config/settings.yaml
config/*.local.yaml

# --- Data (keep folder structure, never commit datasets) ---------------------
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# --- Testing / linting / typing ----------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/
.tox/

# --- Spark / Delta local artefacts -------------------------------------------
spark-warehouse/
metastore_db/
derby.log
_delta_log/
*.crc
checkpoints/

# --- Databricks --------------------------------------------------------------
.databricks/
bundle.tfstate*

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/

# --- Logs --------------------------------------------------------------------
logs/
*.log

# --- IDE / OS ----------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
