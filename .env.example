# =============================================================================
# Environment variables template
# Copy to `.env` (git-ignored) and fill in real values locally:
#     Copy-Item .env.example .env
# NEVER commit `.env`. On Databricks, use Databricks secret scopes instead.
# =============================================================================

# Runtime environment: dev | test | prod
CI_ENV=dev
CI_LOG_LEVEL=INFO

# Path to the YAML settings file (defaults to config/settings.yaml, then the example)
CI_SETTINGS_FILE=config/settings.yaml

# --- Databricks
# Recommended: OAuth login via the CLI (no token stored here):
#   databricks auth login --host https://<your-workspace>.cloud.databricks.com --profile career-intelligence
# The CLI and SDKs then read the profile from ~/.databrickscfg.
DATABRICKS_CONFIG_PROFILE=career-intelligence
# Workspace host (without https://) and SQL warehouse used by the search client / app.
# Workspace-specific, not secrets — but keep them in .env only, never in the repository.
# The access token is NOT configured here: it is obtained in memory from the CLI login above.
# DATABRICKS_SERVER_HOSTNAME=<your-workspace>.cloud.databricks.com
# DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
# (alternative to the warehouse id) DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<sql-warehouse-id>

# --- External data source credentials (see docs/DATA_SOURCES.md)
# ROME, ONISEP, BMO and DARES bulk files need NO credentials.
# Only required if the francetravail.io APIs are adopted (OAuth2 client credentials,
# obtained by registering an application on francetravail.io):
# FRANCE_TRAVAIL_CLIENT_ID=<client-id>
# FRANCE_TRAVAIL_CLIENT_SECRET=<client-secret>
